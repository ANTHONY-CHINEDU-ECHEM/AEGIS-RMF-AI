new file mode 100644
index 0000000..cc5e54c
--- /dev/null
+++ b/src/aegis_rmf/graph/__init__.py
@@ -0,0 +1,23 @@
+"""Knowledge graph: the store contract, the memory and Neo4j backends, and the builder."""
+from aegis_rmf.graph.base import GraphStore
+from aegis_rmf.graph.builder import build_graph
+from aegis_rmf.graph.memory_store import MemoryGraphStore
+
+
+def build_store(settings) -> GraphStore:
+    """Create the graph store named by ``settings.graph_backend``.
+
+    The Neo4j backend is imported lazily so the offline memory backend works
+    without a running server.
+    """
+    backend = str(settings.graph_backend).lower()
+    if backend == "memory":
+        return MemoryGraphStore()
+    if backend == "neo4j":
+        from aegis_rmf.graph.neo4j_store import Neo4jGraphStore
+
+        return Neo4jGraphStore(settings.neo4j_uri, settings.neo4j_user, settings.neo4j_password, settings.neo4j_database)
+    raise ValueError(f"Unknown graph backend '{settings.graph_backend}'. Use memory or neo4j.")
+
+
+__all__ = ["GraphStore", "MemoryGraphStore", "build_graph", "build_store"]
